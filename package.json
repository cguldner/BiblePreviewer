{
  "name": "bible-previewer",
  "version": "2.1.0",
  "description": "Turns every bible verse into a link you can hover over to see the contents of the verse",
  "main": "biblePreviewer.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cguldner/BiblePreviewer.git"
  },
  "scripts": {
    "build:styles": "node scripts/buildStyles.js",
    "build:prod": "npm run build:styles && webpack --env NODE_ENV=production",
    "build:dev": "npm run build:styles && webpack",
    "clean": "rm -rf dist css/generated *.zip",
    "zip": "rm -rf *.zip && bash scripts/get_versions.sh && python scripts/create_zips.py",
    "watch:styles": "node scripts/buildStyles.js --watch",
    "watch": "node scripts/buildStyles.js --watch-and-build",
    "cypress:gui": "cypress open",
    "cypress:run": "cypress run --record false --browser chrome --headed",
    "test": "node --test",
    "test:ci": "npm run test && npm run cypress:run",
    "lint": "eslint . --max-warnings 0 --ignore-pattern dist && stylelint **/*.scss",
    "lint:fix": "eslint . --fix --ignore-pattern dist"
  },
  "author": "Cody Guldner",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/cguldner/BiblePreviewer/issues"
  },
  "homepage": "https://github.com/cguldner/BiblePreviewer#readme",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "cypress": "^15.19.0",
    "cypress-real-events": "^1.15.0",
    "dotenv-webpack": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-cypress": "^6.4.3",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.2.1",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-regexp": "^3.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.22",
    "postcss-loader": "^8.2.1",
    "sass": "^1.101.7",
    "start-server-and-test": "^3.0.11",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "webpack": "^5.109.0",
    "webpack-cli": "^7.2.1"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  }
}
